# UID and GID of the user which should be used to run most services in common uid:gid format. Often something like 1000:1000
# You can determine your this line with your own uid and gid by `echo "DOCKER_LOCAL_USER=$(shell id -u):$(shell id -g)"`
DOCKER_LOCAL_USER=1000:1000

DAGSTER_POSTGRES_USER=postgres_user
DAGSTER_POSTGRES_PASSWORD=postgres_password
DAGSTER_POSTGRES_DB=postgres_db
DAGSTER_CURRENT_IMAGE=dagster_pipeline_image

IPL_LAMASSU_INTERNAL_BASE_URL=http://localhost:8080/

IPL_POSTGIS_VERSION_TAG=18-3.7-alpine
IPL_POSTGRES_HOST=localhost
IPL_POSTGRES_USER=postgres_user
IPL_POSTGRES_PASSWORD=postgres_password
IPL_POSTGRES_DB=postgres_db
IPL_POSTGRES_PORT=5432

# ENV Variables for GTFS Import (this config reuses the ipl_postgis database,
# which might be different in a prod setup)
IPL_GTFS_IMPORTER_IMAGE=ghcr.io/mobidata-bw/postgis-gtfs-importer:2023-12-07t21.27.38-2492186
IPL_GTFS_DB_IMAGE=ghcr.io/mobidata-bw/postgis-with-pg-plan-filter
IPL_GTFS_DB_POSTGRES_HOST=ipl_postgis
IPL_GTFS_DB_POSTGRES_USER=${IPL_POSTGRES_USER}
IPL_GTFS_DB_POSTGRES_PASSWORD=${IPL_POSTGRES_PASSWORD}
IPL_GTFS_DB_POSTGRES_DB=${IPL_POSTGRES_DB}
# Use a small gtfs file with shapes for fast feedback
IPL_MAIN_GTFS_IMPORTER_GTFS_DOWNLOAD_URL=https://gtfs.mfdz.de/SBAHN-S.with_shapes.gtfs.zip
IPL_MAIN_GTFS_IMPORTER_GTFS_DOWNLOAD_USER_AGENT=MobiData-BW
IPL_MAIN_GTFS_DB_POSTGRES_SCHEMA=main_gtfs
IPL_MAIN_GTFS_DB_POSTGREST_USER=postgrest
IPL_MAIN_GTFS_DB_POSTGREST_PASSWORD=password
PGBOUNCER_IMAGE=bitnami/pgbouncer:1
PGBOUNCER_POSTGRES_PORT=6432
PGBOUNCER_POSTGRES_USER=postgres

# Only required, when starting via dagster dev, not via docker. Replace $PWD by your working dir
IPL_GTFS_IMPORTER_HOST_GTFS_OUTPUT_DIR=$PWD/pipeline/var/gtfs
IPL_GTFS_IMPORTER_HOST_CUSTOM_SCRIPTS_DIR=$PWD/pipeline/etc/gtfs
# This assumes, that the ipl platform is started in a directory `ipl` which's name becomes
# the docker project name and is prefixed to the `ipl` network defined in docker-compose.
# This var need's to be redefined in e.g. `.env.local` if run from a different dir.
IPL_GTFS_IMPORTER_NETWORK=ipl_ipl
# Which schema to import into within each GTFS-dataset-specific PostgreSQL DB.
# Note: don't modify this without also adapting etc/gtfs/postprocessing.d/* accordingly.
IPL_GTFS_IMPORTER_SCHEMA=api

# Credentials for RadVIS Download
RADVIS_WFS_USER=radvisuser
RADVIS_WFS_PASSWORD=password

IPL_WEBCAM_SERVER=http://webcamserver.de/
IPL_WEBCAM_USER=FTP_USER
IPL_WEBCAM_PASSWORD=FTP_password
# FTP Worker Count
IPL_WEBCAM_WORKER=1
# How long the images should be kept, in days
IPL_WEBCAM_KEEP_DAYS=7
# Path where the images should be stored
IPL_WEBCAM_IMAGE_PATH=/tmp/webcam-images/
# Path where the symlinks with latest image and the index page should be generated to
IPL_WEBCAM_SYMLINK_PATH=/tmp/webcam-images/

# Moblithek download credentials
IPL_MOBILITHEK_CERT_PATH=files/mobilithek-mobidata.crt.pem
IPL_MOBILITHEK_KEY_PATH=files/mobilithek-mobidata.key.pem

# Traffic related datasets
ROADWORKS_SVZBW_DATEX2_DOWNLOAD_URL=https://ROADWORKS_SVZBW_DATEX2_DOWNLOAD_URL/
REROUTING_MANAGEMENT_SVZBW_DATEX2_DOWNLOAD_URL=https://ROADWORKS_SVZBW_DATEX2_DOWNLOAD_URL/

IPL_INCIDENTS_LMSBW_DATEX2_DOWNLOAD_URL=https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/877480776736407552/clientPullService?subscriptionID=877480776736407552
IPL_ROADWORKS_ADB_SHORT_TERM_DATEX2_DOWNLOAD_URL=https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/803715141871759360/clientPullService?subscriptionID=803715141871759360
IPL_ROADWORKS_ADB_LONG_TERM_DATEX2_DOWNLOAD_URL=https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/803715338412466176/clientPullService?subscriptionID=803715338412466176

# WWW root where publications are published to
WWW_ROOT_DIR=/tmp/www

# Directory to generate intermediate parquet files in. If dagster is run via docker, this should be mounted as volume
GEOPARQUET_TEMP_DIR=./tmp/geoparquet/traffic
